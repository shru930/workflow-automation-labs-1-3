<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan-approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_loan-approval">
    <bpmn:participant id="Participant_Main" name="Loan Processing" processRef="loan-approval" />
  </bpmn:collaboration>
  <bpmn:process id="loan-approval" name="Loan Approval" isExecutable="true">
    <bpmn:documentation>Lab 1: validates an application, gets a credit assessment over REST, decides with DMN and routes to approval, rejection or manual review.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="Automated Loan System">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ApproveMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Officer" name="Loan Officer">
        <bpmn:flowNodeRef>Gw_ReviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkOfficerRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfficerRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Application" name="Application&#10;received     ​">
      <bpmn:documentation>Started with applicant details as process variables.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate applicant">
      <bpmn:documentation>Spring Boot job worker: checks the fields and returns validationPassed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab1.validate-applicant" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Application&#10;valid?         ​" default="Flow_ValidNo">
      <bpmn:documentation>Exclusive: valid, or not (default).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkInvalid" name="Mark invalid">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="REJECTED_INVALID"' resultVariable="finalStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidNo</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Invalid" name="Rejected&#10;invalid     ​">
      <bpmn:documentation>End: failed validation.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Credit" name="Get credit assessment" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>REST Connector: POST to the mock credit-assessment API.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8101/api/credit/assess" target="url" />
          <zeebe:input source='={"Content-Type": "application/json"}' target="headers" />
          <zeebe:input source="={applicantId: applicantId, monthlyIncome: monthlyIncome, loanAmount: loanAmount}" target="body" />
          <zeebe:input source="3" target="connectionTimeoutInSeconds" />
          <zeebe:input source="3" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value='={creditScore: response.body.score, creditRisk: response.body.risk, creditStatus: "OK"}' />
          <zeebe:header key="errorExpression" value='=if is defined(error) then bpmnError("CREDIT_API_ERROR", error.message) else null' />
          <zeebe:header key="retryBackoff" value="PT2S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Credit" name="Credit API error ​" cancelActivity="true" attachedToRef="Task_Credit">
      <bpmn:documentation>API error or timeout: the application goes to a person instead of failing.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source='="UNAVAILABLE"' target="creditStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Bnd_Credit_def" errorRef="Err_Credit" />
    </bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_Decide" name="Classify application">
      <bpmn:documentation>DMN decision: Approved, Rejected or Manual Review.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan-decision" resultVariable="loanDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Loan&#10;decision? ​" default="Flow_Manual">
      <bpmn:documentation>Routes on the DMN result. Manual review is the default.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkRejected" name="Mark rejected">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="REJECTED"' resultVariable="finalStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Rejected" name="Application&#10;rejected      ​">
      <bpmn:documentation>End: DMN rejection.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_ApproveMerge">
      <bpmn:documentation>Merge: DMN approval or officer approval.</bpmn:documentation>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewYes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkApproved" name="Mark approved">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="APPROVED"' resultVariable="finalStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Approved" name="Application&#10;approved   ​">
      <bpmn:documentation>End: approved.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_ReviewMerge">
      <bpmn:documentation>Merge: DMN manual review or credit API error.</bpmn:documentation>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review" name="Review application">
      <bpmn:documentation>Tasklist task for the loan officer.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="loan-review-form" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Review" name="Review&#10;outcome? ​" default="Flow_ReviewNo">
      <bpmn:documentation>Exclusive: approve, or reject (default).</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkOfficerRejected" name="Mark rejected&#10;by officer">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="REJECTED_BY_OFFICER"' resultVariable="finalStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewNo</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_OfficerRejected" name="Rejected&#10;by officer ​">
      <bpmn:documentation>End: rejected at review.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Application" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_ValidYes" name="Yes ​" sourceRef="Gw_Valid" targetRef="Task_Credit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidNo" name="No ​" sourceRef="Gw_Valid" targetRef="Task_MarkInvalid" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_MarkInvalid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Credit" targetRef="Task_Decide" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Decide" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved ​" sourceRef="Gw_Decision" targetRef="Gw_ApproveMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision.decision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected ​" sourceRef="Gw_Decision" targetRef="Task_MarkRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision.decision = "Rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manual" name="Manual&#10;review ​" sourceRef="Gw_Decision" targetRef="Gw_ReviewMerge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_MarkRejected" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Bnd_Credit" targetRef="Gw_ReviewMerge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_ReviewMerge" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Review" targetRef="Gw_Review" />
    <bpmn:sequenceFlow id="Flow_ReviewYes" name="Approve ​" sourceRef="Gw_Review" targetRef="Gw_ApproveMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewNo" name="Reject ​" sourceRef="Gw_Review" targetRef="Task_MarkOfficerRejected" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_MarkOfficerRejected" targetRef="End_OfficerRejected" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_ApproveMerge" targetRef="Task_MarkApproved" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_MarkApproved" targetRef="End_Approved" />
  </bpmn:process>
  <bpmn:error id="Err_Credit" name="Credit API error" errorCode="CREDIT_API_ERROR" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_loan-approval">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="1568" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1538" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Officer_di" bpmnElement="Lane_Officer" isHorizontal="true">
        <dc:Bounds x="130" y="320" width="1538" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Application_di" bpmnElement="Start_Application">
        <dc:Bounds x="202" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="277" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="320" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Valid_di" bpmnElement="Gw_Valid" isMarkerVisible="true">
        <dc:Bounds x="495" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="284" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkInvalid_di" bpmnElement="Task_MarkInvalid">
        <dc:Bounds x="620" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Invalid_di" bpmnElement="End_Invalid">
        <dc:Bounds x="802" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="147" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Credit_di" bpmnElement="Task_Credit">
        <dc:Bounds x="620" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Credit_di" bpmnElement="Bnd_Credit">
        <dc:Bounds x="652" y="277" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="297" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decide_di" bpmnElement="Task_Decide">
        <dc:Bounds x="770" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decision_di" bpmnElement="Gw_Decision" isMarkerVisible="true">
        <dc:Bounds x="945" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836" y="278" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkRejected_di" bpmnElement="Task_MarkRejected">
        <dc:Bounds x="1070" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="1252" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="147" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ApproveMerge_di" bpmnElement="Gw_ApproveMerge" isMarkerVisible="true">
        <dc:Bounds x="1245" y="230" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkApproved_di" bpmnElement="Task_MarkApproved">
        <dc:Bounds x="1370" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="1552" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1490" y="277" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ReviewMerge_di" bpmnElement="Gw_ReviewMerge" isMarkerVisible="true">
        <dc:Bounds x="945" y="360" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="1070" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Review_di" bpmnElement="Gw_Review" isMarkerVisible="true">
        <dc:Bounds x="1245" y="360" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="414" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkOfficerRejected_di" bpmnElement="Task_MarkOfficerRejected">
        <dc:Bounds x="1370" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OfficerRejected_di" bpmnElement="End_OfficerRejected">
        <dc:Bounds x="1552" y="367" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1490" y="407" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="238" y="255" />
        <di:waypoint x="320" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="255" />
        <di:waypoint x="495" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidYes_di" bpmnElement="Flow_ValidYes">
        <di:waypoint x="545" y="255" />
        <di:waypoint x="620" y="255" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="238" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidNo_di" bpmnElement="Flow_ValidNo">
        <di:waypoint x="520" y="230" />
        <di:waypoint x="520" y="125" />
        <di:waypoint x="620" y="125" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="210" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="720" y="125" />
        <di:waypoint x="802" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="720" y="255" />
        <di:waypoint x="770" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="870" y="255" />
        <di:waypoint x="945" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="995" y="255" />
        <di:waypoint x="1245" y="255" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="951" y="238" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="970" y="230" />
        <di:waypoint x="970" y="125" />
        <di:waypoint x="1070" y="125" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="924" y="210" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual">
        <di:waypoint x="970" y="280" />
        <di:waypoint x="970" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="918" y="286" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1170" y="125" />
        <di:waypoint x="1252" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="670" y="313" />
        <di:waypoint x="670" y="385" />
