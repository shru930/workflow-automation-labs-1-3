<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_hospital-appointment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_hospital-appointment">
    <bpmn:participant id="Participant_Main" name="Hospital" processRef="hospital-appointment" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-appointment" name="Hospital Appointment and Triage" isExecutable="true">
    <bpmn:documentation>Lab 3 (educational, synthetic data only): registers a patient, applies triage rules, checks slots through a mock scheduling API and routes cases to staff.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Nurse" name="Triage Nurse">
        <bpmn:flowNodeRef>Task_Urgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Urgent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Appointment System">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SlotMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Booked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reception" name="Reception Staff">
        <bpmn:flowNodeRef>Task_Priority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Priority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkReferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Referred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkWaitlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Waitlisted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Request&#10;received ​">
      <bpmn:documentation>Started with synthetic patient details as process variables.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate registration">
      <bpmn:documentation>Spring Boot job worker: checks the registration fields.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3.validate-registration" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Registration&#10;valid?           ​" default="Flow_ValidNo">
      <bpmn:documentation>Exclusive: valid, or not (default).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkInvalid" name="Mark invalid">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="INVALID_REGISTRATION"' resultVariable="bookingStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidNo</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Invalid" name="Request&#10;rejected ​">
      <bpmn:documentation>End: failed validation.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_Triage" name="Apply triage rules">
      <bpmn:documentation>DMN decision: Routine, Priority Review or Urgent Assessment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-category" resultVariable="triageResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Triage" name="Triage&#10;category? ​" default="Flow_Priority">
      <bpmn:documentation>Routes on the DMN result. Priority Review is the default, so a person checks anything unexpected.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
      <bpmn:outgoing>Flow_Urgent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Urgent" name="Immediate assessment">
      <bpmn:documentation>Tasklist task: the nurse assesses urgent cases straight away (simulated).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="urgent-assessment-form" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Urgent</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_MarkUrgent" name="Mark assessed">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="URGENT_ASSESSED"' resultVariable="bookingStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Urgent" name="Urgent case&#10;handled        ​">
      <bpmn:documentation>End: urgent case handled by staff.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_SlotMerge">
      <bpmn:documentation>Merge: routine request, or request cleared by staff.</bpmn:documentation>
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:incoming>Flow_Proceed</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Prepare" name="Request availability">
      <bpmn:documentation>Spring Boot job worker: builds the availability request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3.request-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Slots" name="Get available slots" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>REST Connector: GET from the mock scheduling API.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://localhost:8103/api/scheduling/slots" target="url" />
          <zeebe:input source='={"Content-Type": "application/json"}' target="headers" />
          <zeebe:input source="={department: department, date: requestedDate}" target="queryParameters" />
          <zeebe:input source="5" target="connectionTimeoutInSeconds" />
          <zeebe:input source="5" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={availableSlots: response.body.slots, slotCount: count(response.body.slots)}" />
          <zeebe:header key="retryBackoff" value="PT2S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Slots" name="Slot&#10;available? ​" default="Flow_SlotNo">
      <bpmn:documentation>Exclusive: at least one slot, or none (default).</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SlotNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Book" name="Book appointment">
      <bpmn:documentation>Spring Boot job worker: books the first slot.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3.book-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotYes</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Booked" name="Appointment&#10;booked         ​">
      <bpmn:documentation>End: appointment confirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Priority" name="Priority staff review">
      <bpmn:documentation>Tasklist task: staff decide whether the request can go ahead.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="priority-review-form" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Priority" name="Review&#10;outcome? ​" default="Flow_Refer">
      <bpmn:documentation>Exclusive: proceed to booking, or refer (default).</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_MarkReferred" name="Mark referred">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="REFERRED_BY_STAFF"' resultVariable="bookingStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Refer</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Referred" name="Patient&#10;referred ​">
      <bpmn:documentation>End: staff referred the patient elsewhere.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_NoSlot" name="Resolve no slot">
      <bpmn:documentation>Tasklist task: staff decide what to do when no slot is free.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="no-slot-form" />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotNo</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_MarkWaitlist" name="Mark waitlisted">
      <bpmn:documentation>Records the final status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression='="WAITLISTED"' resultVariable="bookingStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Waitlisted" name="Patient&#10;waitlisted ​">
      <bpmn:documentation>End: patient placed on the waiting list.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Request" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_ValidYes" name="Yes ​" sourceRef="Gw_Valid" targetRef="Task_Triage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidNo" name="No ​" sourceRef="Gw_Valid" targetRef="Task_MarkInvalid" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_MarkInvalid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Triage" targetRef="Gw_Triage" />
    <bpmn:sequenceFlow id="Flow_Routine" name="Routine ​" sourceRef="Gw_Triage" targetRef="Gw_SlotMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageResult.category = "Routine"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Urgent" name="Urgent ​" sourceRef="Gw_Triage" targetRef="Task_Urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageResult.category = "Urgent Assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority" name="Priority ​" sourceRef="Gw_Triage" targetRef="Task_Priority" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Urgent" targetRef="Task_MarkUrgent" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_MarkUrgent" targetRef="End_Urgent" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Priority" targetRef="Gw_Priority" />
    <bpmn:sequenceFlow id="Flow_Proceed" name="Proceed ​" sourceRef="Gw_Priority" targetRef="Gw_SlotMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewOutcome = "PROCEED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refer" name="Refer ​" sourceRef="Gw_Priority" targetRef="Task_MarkReferred" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_MarkReferred" targetRef="End_Referred" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_SlotMerge" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Prepare" targetRef="Task_Slots" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Slots" targetRef="Gw_Slots" />
    <bpmn:sequenceFlow id="Flow_SlotYes" name="Yes ​" sourceRef="Gw_Slots" targetRef="Task_Book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SlotNo" name="No ​" sourceRef="Gw_Slots" targetRef="Task_NoSlot" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Book" targetRef="End_Booked" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NoSlot" targetRef="Task_MarkWaitlist" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_MarkWaitlist" targetRef="End_Waitlisted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_hospital-appointment">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="1718" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Nurse_di" bpmnElement="Lane_Nurse" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1688" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="190" width="1688" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Reception_di" bpmnElement="Lane_Reception" isHorizontal="true">
        <dc:Bounds x="130" y="450" width="1688" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Request_di" bpmnElement="Start_Request">
        <dc:Bounds x="202" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="277" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="320" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Valid_di" bpmnElement="Gw_Valid" isMarkerVisible="true">
        <dc:Bounds x="495" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="198" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkInvalid_di" bpmnElement="Task_MarkInvalid">
        <dc:Bounds x="470" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Invalid_di" bpmnElement="End_Invalid">
        <dc:Bounds x="652" y="367" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="590" y="407" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Triage_di" bpmnElement="Task_Triage">
        <dc:Bounds x="620" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Triage_di" bpmnElement="Gw_Triage" isMarkerVisible="true">
        <dc:Bounds x="795" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="686" y="278" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Urgent_di" bpmnElement="Task_Urgent">
        <dc:Bounds x="920" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkUrgent_di" bpmnElement="Task_MarkUrgent">
        <dc:Bounds x="1070" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Urgent_di" bpmnElement="End_Urgent">
        <dc:Bounds x="1252" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="147" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_SlotMerge_di" bpmnElement="Gw_SlotMerge" isMarkerVisible="true">
        <dc:Bounds x="945" y="230" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prepare_di" bpmnElement="Task_Prepare">
        <dc:Bounds x="1070" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Slots_di" bpmnElement="Task_Slots">
        <dc:Bounds x="1220" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Slots_di" bpmnElement="Gw_Slots" isMarkerVisible="true">
        <dc:Bounds x="1395" y="230" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1340" y="198" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Book_di" bpmnElement="Task_Book">
        <dc:Bounds x="1520" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Booked_di" bpmnElement="End_Booked">
        <dc:Bounds x="1702" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="277" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Priority_di" bpmnElement="Task_Priority">
        <dc:Bounds x="770" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Priority_di" bpmnElement="Gw_Priority" isMarkerVisible="true">
        <dc:Bounds x="945" y="490" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="544" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkReferred_di" bpmnElement="Task_MarkReferred">
        <dc:Bounds x="1070" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Referred_di" bpmnElement="End_Referred">
        <dc:Bounds x="1252" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="537" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NoSlot_di" bpmnElement="Task_NoSlot">
        <dc:Bounds x="1370" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkWaitlist_di" bpmnElement="Task_MarkWaitlist">
        <dc:Bounds x="1520" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Waitlisted_di" bpmnElement="End_Waitlisted">
        <dc:Bounds x="1702" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="537" width="160" height="28" />
        </bpmndi:BPMNLabel>
